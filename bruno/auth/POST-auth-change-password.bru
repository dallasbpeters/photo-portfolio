meta {
  name: POST auth/change-password
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/change-password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "currentPassword": "",
    "newPassword": ""
  }
}

docs {
  Change the signed-in user's password.
}
