meta {
  name: POST pinterest/board
  type: http
  seq: 1
}

POST {
  url: {{baseUrl}}/api/pinterest/board
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "url": ""
  }
}

docs {
  Read the pins off a public Pinterest board.

  Read from the board's public RSS feed, which carries only the most recent pins. More would need OAuth and a reviewed app.
}
