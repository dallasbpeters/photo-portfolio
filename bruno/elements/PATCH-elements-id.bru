meta {
  name: PATCH elements/{id}
  type: http
  seq: 1
}

patch {
  url: {{baseUrl}}/api/elements/{{id}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "coverUrl": "",
    "description": "",
    "imageUrls": [
      ""
    ],
    "name": ""
  }
}

docs {
  Update an element.
}
