meta {
  name: POST ai/generate
  type: http
  seq: 1
}

POST {
  url: {{baseUrl}}/api/ai/generate
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "modelId": "",
    "prompt": "",
    "sourceImageUrl": ""
  }
}

docs {
  Generate an image from a prompt, optionally from a source image.

  The result is copied to our own blob host before returning — fal serves from a temporary location that would expire under the board.
}
