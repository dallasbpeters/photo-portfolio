meta {
  name: PATCH models/{id}
  type: http
  seq: 1
}

patch {
  url: {{baseUrl}}/api/models/{{id}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "enabled": false,
    "id": "",
    "imageParam": "image_url",
    "input": "",
    "label": "",
    "lora": "",
    "sortOrder": 0,
    "vector": false
  }
}

docs {
  Update a model.
}
