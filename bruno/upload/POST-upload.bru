meta {
  name: POST upload
  type: http
  seq: 1
}

POST {
  url: {{baseUrl}}/api/upload
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  Upload an image to blob storage.

  multipart/form-data with a single `file` field. Answers the blob URL the image is now served from.
}
