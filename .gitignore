node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example
.vercel

# Apple Icon Composer source (design asset, not build input)
Icon.icon/
watermarked-photos-backup.json
.env.local
# Anchored to the repo root on purpose. Unanchored, "photos/" matches a
# directory of that name at any depth — it was quietly excluding api/photos/,
# where the endpoints live, and api/photos/reorder.ts had already gone missing
# from the repo because of it.
/photos/
/specs/
.claude/
.specify/

# Training sets. Tens of megabytes of images assembled for a LoRA run — they
# are working material for a model, not source, and git is the wrong place for
# them.
# Any training set at the repo root, whatever it is called — the first version
# of this only matched "training*.zip" and let design.zip and photography.zip
# straight through.
/*.zip
/datasets/

# Model weights. Tens of megabytes each and not source; they live in blob
# storage, where fal fetches them from. See scripts/upload-lora.ts.
loras/
*.safetensors

# Bruno writes run artefacts beside the collection; the collection itself is
# generated by `pnpm bruno` and is committed so it can be opened directly.
bruno/**/*.results.json
