{
  "name": "photo-portfolio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "api:docs": "tsx scripts/generate-openapi.ts",
    "build": "vite build",
    "build:addison": "cross-env VITE_SITE=addison vite build",
    "build:cyan": "cross-env VITE_SITE=cyan vite build",
    "build:dallas-images": "cross-env VITE_SITE=dallas-images vite build",
    "check:migrations": "tsx scripts/check-migrations.ts",
    "check:size": "tsx scripts/check-file-size.ts",
    "check:utilities": "tsx scripts/check-utilities.ts",
    "clean": "rm -rf dist",
    "db:add-user": "tsx scripts/add-user.ts",
    "db:info": "tsx scripts/db-info.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:verify-login": "tsx scripts/verify-login.ts",
    "debug": "vite --debug transform",
    "dev": "cross-env VITE_SITE=dallas-images node scripts/dev-stack.mjs",
    "dev:addison": "cross-env VITE_SITE=addison node scripts/dev-stack.mjs",
    "dev:cyan": "cross-env VITE_SITE=cyan node scripts/dev-stack.mjs",
    "dev:dallas-images": "cross-env VITE_SITE=dallas-images node scripts/dev-stack.mjs",
    "electron:build": "electron-builder --mac",
    "electron:dev": "electron .",
    "fix": "npx ultracite fix --claude",
    "lint": "tsc --noEmit && tsx scripts/check-file-size.ts && tsx scripts/check-migrations.ts && tsx scripts/check-utilities.ts src/boards && tsx scripts/check-utilities.ts src/pages",
    "lora:upload": "tsx scripts/upload-lora.ts",
    "openapi": "tsx scripts/generate-openapi.ts",
    "preview": "vite preview",
    "shots": "vitest run --config vitest.shader.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "ultracite": "npx ultracite fix",
    "vercel:blob:create": "vercel blob create-store",
    "vercel:env:pull": "vercel env pull .env.development.local"
  },
