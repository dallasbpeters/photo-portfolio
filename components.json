{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "base-nova",
  "rsc": false,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "src/index.css",
    "baseColor": "neutral",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "lucide",
  "rtl": false,
  "aliases": {
    "components": "@/components",
    "utils": "@/lib/utils",
    "ui": "@/components/ui",
    "lib": "@/lib",
    "hooks": "@/hooks"
  },

  "menuColor": "default",
  "menuAccent": "subtle",
  "registries": {
    "@shaders": {
      "url": "https://shaders.com/r/react/{name}.json",
      "headers": { "Authorization": "Bearer ${SHADERS_API_KEY}" }
    }
  }
}
